generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EquipmentType {
  DESKTOP
  NOTEBOOK
  GAMING_PC
  ALL_IN_ONE
  OTHER
}

enum ServiceOrderStatus {
  OPEN
  RECEIVED
  DIAGNOSING
  AWAITING_APPROVAL
  QUOTE_REJECTED
  APPROVED
  IN_PROGRESS
  WAITING_PART
  COMPLETED
  READY_FOR_PICKUP
  DELIVERED
  CANCELED
}

enum ChecklistType {
  ENTRY
  EXIT
}

enum ChecklistStatus {
  PENDING
  COMPLETED
}

enum QuoteStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  CANCELED
}

enum QuoteItemType {
  SERVICE
  PART
  OTHER
}

enum QuoteRequestStatus {
  NEW
  CONTACTED
  DISMISSED
}

enum ServiceOrderTimelineEventType {
  ORDEM_CRIADA
  EQUIPAMENTO_RECEBIDO
  CHECKLIST_ENTRADA_CONCLUIDO
  DIAGNOSTICO_REGISTRADO
  ORCAMENTO_CRIADO
  ORCAMENTO_ENVIADO
  ORCAMENTO_APROVADO
  ORCAMENTO_REJEITADO
  SERVICO_INICIADO
  AGUARDANDO_PECA
  PECA_RECEBIDA
  RELATORIO_SERVICO_REGISTRADO
  SERVICO_CONCLUIDO
  CHECKLIST_SAIDA_CONCLUIDO
  EQUIPAMENTO_PRONTO
  EQUIPAMENTO_ENTREGUE
  ORDEM_CANCELADA
  OBSERVACAO_ADICIONADA
}

model User {
  id                    String                      @id @default(uuid()) @db.Uuid
  name                  String                      @db.VarChar(120)
  email                 String                      @unique @db.VarChar(255)
  passwordHash          String                      @db.VarChar(255)
  image                 String?                     @db.VarChar(500)
  isActive              Boolean                     @default(true)
  hasCompletedQuickstart Boolean                    @default(false)
  createdAt             DateTime                    @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime                    @updatedAt @db.Timestamptz(3)
  createdServiceOrders  ServiceOrder[]              @relation("ServiceOrderCreatedBy")
  completedChecklists   ServiceOrderChecklist[]     @relation("ChecklistCompletedBy")
  registeredDiagnostics Diagnostic[]                 @relation("DiagnosticRegisteredBy")
  registeredServiceReports ServiceReport[]           @relation("ServiceReportRegisteredBy")
  createdQuotes         Quote[]                      @relation("QuoteCreatedBy")
  timelineEvents        ServiceOrderTimelineEvent[] @relation("TimelineResponsibleUser")
  uploadedChecklistAttachments ChecklistAttachment[] @relation("ChecklistAttachmentUploadedBy")

  @@map("users")
}

model Customer {
  id             String         @id @default(uuid()) @db.Uuid
  name           String         @db.VarChar(160)
  document       String?        @unique @db.VarChar(14)
  email          String?        @db.VarChar(255)
  phone          String         @db.VarChar(20)
  secondaryPhone String?        @db.VarChar(20)
  address        String?        @db.Text
  notes          String?        @db.Text
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(3)
  equipment      Equipment[]
  serviceOrders  ServiceOrder[]
  quotes         Quote[]

  @@index([name])
  @@index([phone])
  @@map("customers")
}

model QuoteRequest {
  id                   String             @id @default(uuid()) @db.Uuid
  name                 String             @db.VarChar(160)
  phone                String             @db.VarChar(20)
  email                String?            @db.VarChar(255)
  equipmentType        EquipmentType
  equipmentDescription String?            @db.VarChar(240)
  reportedProblem      String             @db.Text
  status               QuoteRequestStatus @default(NEW)
  contactedAt          DateTime?          @db.Timestamptz(3)
  createdAt            DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime           @updatedAt @db.Timestamptz(3)

  @@index([status, createdAt(sort: Desc)])
  @@index([phone])
  @@map("quote_requests")
}

model Equipment {
  id             String         @id @default(uuid()) @db.Uuid
  customerId     String         @db.Uuid
  type           EquipmentType
  brand          String?        @db.VarChar(100)
  model          String?        @db.VarChar(120)
  serialNumber   String?        @db.VarChar(120)
  color          String?        @db.VarChar(60)
  specifications String?        @db.Text
  notes          String?        @db.Text
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(3)
  customer       Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  serviceOrders  ServiceOrder[]
  quotes         Quote[]

  @@index([customerId])
  @@index([serialNumber])
  @@map("equipment")
}

model ServiceOrder {
  id                  String                      @id @default(uuid()) @db.Uuid
  number              Int                         @unique @default(autoincrement())
  customerId          String                      @db.Uuid
  equipmentId         String                      @db.Uuid
  status              ServiceOrderStatus          @default(OPEN)
  reportedProblem     String                      @db.Text
  receivedAccessories String?                     @db.Text
  generalNotes        String?                     @db.Text
  receivedAt          DateTime?                   @db.Timestamptz(3)
  deliveredAt         DateTime?                   @db.Timestamptz(3)
  createdById         String                      @db.Uuid
  createdAt           DateTime                    @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime                    @updatedAt @db.Timestamptz(3)
  customer            Customer                    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  equipment           Equipment                   @relation(fields: [equipmentId], references: [id], onDelete: Restrict)
  createdBy           User                        @relation("ServiceOrderCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  checklists          ServiceOrderChecklist[]
  diagnostic          Diagnostic?
  serviceReport       ServiceReport?
  quotes              Quote[]
  timeline            ServiceOrderTimelineEvent[]
  checklistAttachments ChecklistAttachment[]

  @@index([status, createdAt])
  @@index([customerId])
  @@index([equipmentId])
  @@map("service_orders")
}

model ServiceOrderChecklist {
  id             String           @id @default(uuid()) @db.Uuid
  serviceOrderId String           @db.Uuid
  type           ChecklistType
  status         ChecklistStatus  @default(PENDING)
  notes          String?          @db.Text
  completedAt    DateTime?        @db.Timestamptz(3)
  completedById  String?          @db.Uuid
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(3)
  serviceOrder   ServiceOrder     @relation(fields: [serviceOrderId], references: [id], onDelete: Restrict)
  completedBy    User?            @relation("ChecklistCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  items          ChecklistItem[]

  @@unique([serviceOrderId, type])
  @@index([status])
  @@map("service_order_checklists")
}

model ChecklistItem {
  id          String                @id @default(uuid()) @db.Uuid
  checklistId String                @db.Uuid
  key         String                @db.VarChar(80)
  label       String                @db.VarChar(180)
  checked     Boolean               @default(false)
  notes       String?               @db.Text
  position    Int
  createdAt   DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime              @updatedAt @db.Timestamptz(3)
  checklist   ServiceOrderChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  @@unique([checklistId, key])
  @@index([checklistId, position])
  @@map("checklist_items")
}

model ChecklistAttachment {
  id                String        @id @default(uuid()) @db.Uuid
  serviceOrderId    String        @db.Uuid
  checklistType     ChecklistType
  bucket            String        @db.VarChar(100)
  objectPath        String        @unique @db.VarChar(500)
  originalName      String        @db.VarChar(255)
  mimeType          String        @db.VarChar(100)
  size              Int
  uploadedById      String        @db.Uuid
  uploadedAt        DateTime?     @db.Timestamptz(3)
  createdAt         DateTime      @default(now()) @db.Timestamptz(3)
  serviceOrder      ServiceOrder  @relation(fields: [serviceOrderId], references: [id], onDelete: Restrict)
  uploadedBy        User          @relation("ChecklistAttachmentUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([serviceOrderId, checklistType, uploadedAt])
  @@index([uploadedById])
  @@map("checklist_attachments")
}

model Diagnostic {
  id                  String       @id @default(uuid()) @db.Uuid
  serviceOrderId      String       @unique @db.Uuid
  description         String       @db.Text
  technicalConclusion String?      @db.Text
  recommendations     String?      @db.Text
  registeredById      String       @db.Uuid
  registeredAt        DateTime     @default(now()) @db.Timestamptz(3)
  createdAt           DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime     @updatedAt @db.Timestamptz(3)
  serviceOrder        ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Restrict)
  registeredBy        User         @relation("DiagnosticRegisteredBy", fields: [registeredById], references: [id], onDelete: Restrict)

  @@map("diagnostics")
}

model ServiceReport {
  id              String       @id @default(uuid()) @db.Uuid
  serviceOrderId  String       @unique @db.Uuid
  workPerformed   String       @db.Text
  partsUsed       String?      @db.Text
  testsPerformed  String?      @db.Text
  notes           String?      @db.Text
  registeredById  String       @db.Uuid
  registeredAt    DateTime     @default(now()) @db.Timestamptz(3)
  createdAt       DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @db.Timestamptz(3)
  serviceOrder    ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Restrict)
  registeredBy    User         @relation("ServiceReportRegisteredBy", fields: [registeredById], references: [id], onDelete: Restrict)

  @@map("service_reports")
}

model ServiceCatalogItem {
  id               String      @id @default(uuid()) @db.Uuid
  name             String      @db.VarChar(160)
  description      String?     @db.Text
  defaultPrice     Decimal     @db.Decimal(12, 2)
  estimatedMinutes Int?
  isActive         Boolean     @default(true)
  createdAt        DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime    @updatedAt @db.Timestamptz(3)
  quoteItems       QuoteItem[]

  @@index([name])
  @@map("service_catalog_items")
}

model Quote {
  id             String       @id @default(uuid()) @db.Uuid
  number         Int          @unique @default(autoincrement())
  seriesId       String       @db.Uuid
  customerId     String       @db.Uuid
  equipmentId    String       @db.Uuid
  serviceOrderId String?      @db.Uuid
  version        Int          @default(1)
  status         QuoteStatus  @default(DRAFT)
  reportedProblem     String   @db.Text
  receivedAccessories String?  @db.Text
  generalNotes        String?  @db.Text
  subtotal       Decimal      @default(0) @db.Decimal(12, 2)
  discount       Decimal      @default(0) @db.Decimal(12, 2)
  total          Decimal      @default(0) @db.Decimal(12, 2)
  validUntil     DateTime?    @db.Date
  notes          String?      @db.Text
  sentAt         DateTime?    @db.Timestamptz(3)
  approvedAt     DateTime?    @db.Timestamptz(3)
  rejectedAt     DateTime?    @db.Timestamptz(3)
  sentIdempotencyKey     String? @db.VarChar(128)
  decisionIdempotencyKey String? @db.VarChar(128)
  createdById    String       @db.Uuid
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  equipment      Equipment    @relation(fields: [equipmentId], references: [id], onDelete: Restrict)
  serviceOrder   ServiceOrder? @relation(fields: [serviceOrderId], references: [id], onDelete: Restrict)
  createdBy      User         @relation("QuoteCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  items          QuoteItem[]

  @@unique([seriesId, version])
  @@index([customerId])
  @@index([equipmentId])
  @@index([serviceOrderId, status])
  @@map("quotes")
}

model QuoteItem {
  id                   String              @id @default(uuid()) @db.Uuid
  quoteId              String              @db.Uuid
  serviceCatalogItemId String?             @db.Uuid
  type                 QuoteItemType
  description          String              @db.VarChar(240)
  quantity             Decimal             @default(1) @db.Decimal(10, 3)
  unitPrice            Decimal             @db.Decimal(12, 2)
  total                Decimal             @db.Decimal(12, 2)
  position             Int
  createdAt            DateTime            @default(now()) @db.Timestamptz(3)
  quote                Quote               @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  serviceCatalogItem   ServiceCatalogItem? @relation(fields: [serviceCatalogItemId], references: [id], onDelete: SetNull)

  @@index([quoteId, position])
  @@index([serviceCatalogItemId])
  @@map("quote_items")
}

model ServiceOrderTimelineEvent {
  id                String                        @id @default(uuid()) @db.Uuid
  serviceOrderId    String                        @db.Uuid
  type              ServiceOrderTimelineEventType
  title             String                        @db.VarChar(180)
  description       String?                       @db.Text
  responsibleUserId String?                       @db.Uuid
  occurredAt        DateTime                      @default(now()) @db.Timestamptz(3)
  metadata          Json?
  idempotencyKey    String                        @db.VarChar(128)
  createdAt         DateTime                      @default(now()) @db.Timestamptz(3)
  serviceOrder      ServiceOrder                  @relation(fields: [serviceOrderId], references: [id], onDelete: Restrict)
  responsibleUser   User?                         @relation("TimelineResponsibleUser", fields: [responsibleUserId], references: [id], onDelete: SetNull)

  @@unique([serviceOrderId, idempotencyKey])
  @@index([serviceOrderId, occurredAt(sort: Desc)])
  @@index([type])
  @@map("service_order_timeline_events")
}
