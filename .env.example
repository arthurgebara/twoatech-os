# Supabase Transaction Pooler (porta 6543) para a aplicação/serverless.
DATABASE_URL="postgresql://postgres.PROJECT_REF:DB_PASSWORD@REGION.pooler.supabase.com:6543/postgres"

# Supabase Session Pooler (porta 5432) para migrations, seed e Prisma Studio.
DIRECT_URL="postgresql://postgres.PROJECT_REF:DB_PASSWORD@REGION.pooler.supabase.com:5432/postgres"

# Supabase Storage privado para anexos das checklists.
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_replace-with-project-key"
SUPABASE_SECRET_KEY="sb_secret_replace-with-project-key"
SUPABASE_STORAGE_BUCKET="service-order-attachments"

AUTH_SECRET="replace-with-a-random-secret"
NEXTAUTH_URL="http://localhost:3000"
ADMIN_NAME="Proprietário TwoATech"
ADMIN_EMAIL="admin@twoatech.com.br"
ADMIN_PASSWORD="replace-with-a-strong-password"
